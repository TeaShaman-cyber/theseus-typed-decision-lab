#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
cd "$ROOT"
export PYTHONDONTWRITEBYTECODE=1

echo '== required repository contract =='
for path in   README.md   docs/architecture.md   docs/research-lifecycle.md   docs/upstreams.md   contracts/README.md   experiments/README.md   receipts/README.md   config/upstreams.json   config/runtime-profiles.json   requirements/semif-cpu-runtime.lock.txt   requirements/kev-cpu-runtime.txt   fixtures/smoke/semif-native.jsonl   fixtures/smoke/kev-native.json   scripts/check_committed_whitespace.py   .github/ISSUE_TEMPLATE/experiment.yml   .github/workflows/qa.yml   .github/workflows/semif-cpu-canary.yml   .github/workflows/semif-toolchain-build.yml   .github/workflows/kev-cpu-canary.yml   .github/workflows/kev-wheelhouse-seed.yml; do
  test -s "$path" || {
    echo "QA_CONTRACT_DRIFT: missing_or_empty=$path" >&2
    exit 2
  }
done

echo '== unit and contract tests =='
python3 -m unittest discover -s tests -v

echo '== python syntax =='
python3 -m compileall -q scripts tests

echo '== tracked JSON syntax =='
while IFS= read -r path; do
  python3 -m json.tool "$path" >/dev/null
done < <(git ls-files '*.json' | sort)

echo '== tracked JSONL syntax =='
while IFS= read -r path; do
  python3 - "$path" <<'PY'
import json
import sys
from pathlib import Path
path = Path(sys.argv[1])
for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
    if line.strip():
        try:
            json.loads(line)
        except Exception as exc:
            raise SystemExit(f"{path}:{number}: {exc}")
PY
done < <(git ls-files '*.jsonl' | sort)

echo '== workflow contract =='
python3 - <<'PY'
from pathlib import Path
qa = Path(".github/workflows/qa.yml").read_text(encoding="utf-8")
canary = Path(".github/workflows/semif-cpu-canary.yml").read_text(encoding="utf-8")
toolchain = Path(".github/workflows/semif-toolchain-build.yml").read_text(encoding="utf-8")
required = [
    "workflow_dispatch:",
    "permissions:",
    "contents: read",
    "timeout-minutes: 60",
    "1f2dea3e25379f9dfc98cb83c324f00ab5deda37",
    "c1899de289a04d12100db370d81485cdf75e47ca",
    "23749fefcc72300e3a2ad315e1317431b06b590a",
    "RUNTIME_FEASIBILITY_ONLY",
]
combined = canary + "\n" + toolchain + "\n" + Path("scripts/write_runtime_receipt.py").read_text(encoding="utf-8") + "\n" + Path("scripts/write_toolchain_receipt.py").read_text(encoding="utf-8")
for item in required:
    if item not in combined:
        raise SystemExit(f"workflow contract missing: {item}")
if "pull_request_target:" in qa or "pull_request_target:" in canary or "pull_request_target:" in toolchain:
    raise SystemExit("unsafe workflow trigger: pull_request_target")
for item in [
    "runs-on: ubuntu-24.04",
    "--require-hashes",
    "--only-binary=:all:",
    "requirements/semif-cpu-runtime.lock.txt",
    "2.10.0+cpu",
    "llama-cpp-python==$LLAMA_CPP_VERSION",
    "semif-cpu-toolchain.tar.gz",
    'sha256sum "semif-cpu-toolchain.tar.gz"',
    "compression-level: 0",
]:
    if item not in toolchain:
        raise SystemExit(f"toolchain workflow contract missing: {item}")
for item in [
    "--runtime-package",
    "runtime-package-receipt.json",
    "Verify pinned GGUF checksum",
    "qwen3_0_6b_gguf.sha256",
    "sha256sum -c -",
]:
    if item not in canary:
        raise SystemExit(f"canary workflow contract missing: {item}")
kev = Path(".github/workflows/kev-cpu-canary.yml").read_text(encoding="utf-8")
for item in [
    "workflow_dispatch:",
    "runs-on: ubuntu-24.04",
    'python-version: "3.12"',
    "7405b72e73e2d24787f3720d162a21c974ff2ad2",
    "54f4f8777356cd5bbbb6c6919c657f26e6f2f6d8",
    "dc7cdfe2ee4154fa7e30f5b51ca41bfa40174e68",
    "RUNTIME_FEASIBILITY_ONLY",
    "run_kev_cpu_canary.py",
]:
    if item not in kev:
        raise SystemExit(f"Kev workflow contract missing: {item}")
if "pull_request_target:" in kev:
    raise SystemExit("unsafe Kev workflow trigger: pull_request_target")
for item in [
    "--index-url https://download.pytorch.org/whl/cpu",
    "--extra-index-url https://pypi.org/simple",
    "requirements/kev-cpu-runtime.txt",
    "kev @ git+https://github.com/jaredpalmer/kev.git@$KEV_CODE_REV",
]:
    if item not in kev:
        raise SystemExit(f"Kev cold-path contract missing: {item}")
for forbidden in [
    "actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830",
    "fail-on-cache-miss: true",
    "--no-index",
]:
    if forbidden in kev:
        raise SystemExit(f"Kev canonical canary still uses wheelhouse path: {forbidden}")
kev_seed = Path(".github/workflows/kev-wheelhouse-seed.yml").read_text(encoding="utf-8")
if "Evidence-only experiment retained for reproducibility" not in kev_seed:
    raise SystemExit("Kev wheelhouse workflow must remain explicitly evidence-only")
for item in [
    "actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830",
    "--only-binary=:all:",
    "wheels.sha256",
    "requirements/kev-cpu-runtime.txt",
    "7405b72e73e2d24787f3720d162a21c974ff2ad2",
]:
    if item not in kev_seed:
        raise SystemExit(f"Kev seed contract missing: {item}")
if "pull_request_target:" in kev_seed:
    raise SystemExit("unsafe Kev seed workflow trigger: pull_request_target")
if "tools/dev/check" not in qa:
    raise SystemExit("QA workflow does not call canonical tools/dev/check")
if "fetch-depth: 0" not in qa:
    raise SystemExit("QA workflow must fetch history for committed-range checks")
if "scripts/check_committed_whitespace.py" not in Path("tools/dev/check").read_text(encoding="utf-8"):
    raise SystemExit("canonical QA does not invoke committed whitespace guard")
PY

echo '== committed and local whitespace =='
python3 scripts/check_committed_whitespace.py

echo DEV_CHECK_PASS
